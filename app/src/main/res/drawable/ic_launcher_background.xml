<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标背景层。沿用 app 自己的强调色族（colors.xml 的 mic_gradient_start #6A7CF8），
  135° 线性渐变压到深蓝紫，再叠一层左上的径向高光模拟 HyperOS 玻璃质感。
  自适应图标要求这一层铺满整个 108×108 画布（系统会裁成圆/方/圆角方）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="8"
                android:endX="92"
                android:endY="100"
                android:startColor="#6A7CF8"
                android:endColor="#3E4AD1" />
        </aapt:attr>
    </path>

    <!-- 左上高光，制造玻璃反光的方向感 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30"
                android:centerY="22"
                android:gradientRadius="76"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
