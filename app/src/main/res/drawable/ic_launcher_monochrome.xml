<?xml version="1.0" encoding="utf-8"?>
<!--
  主题图标层（Android 13+ themed icons）。开启「单色图标」后，启动器会忽略这里的
  具体颜色、整层染成同一个色，只保留形状与 alpha，所以几何必须和前景层完全一致：
  同样是 12 点开口的时钟环 + 居中粗对勾，不加整点刻度（理由见前景层注释）。
  这里用纯黑描边，环与对勾同为不透明色，叠加处并集不会留接缝。
  minSdk 33，这一层在所有目标设备上都能生效。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 时钟环：从 -72° 顺时针绕到 -108°，12 点处留缺口，端点圆头 -->
    <path
        android:pathData="M61.42,31.17 A24,24 0 1 1 46.58,31.17"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- 对勾 -->
    <path
        android:pathData="M43,54.5 L51.5,63 L69,42"
        android:strokeColor="#FF000000"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
